# Copy to .env.local (gitignored) and fill in from the Supabase dashboard:
# Project Settings -> API. Never commit real values.

# Project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Safe to expose to the browser — RLS is what protects
# the data behind it, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS entirely. Server-only: must never take a
# NEXT_PUBLIC_ prefix, never be imported into a client component, and never be
# reachable from the browser bundle. Unused as of step 03.
SUPABASE_SERVICE_ROLE_KEY=

# Demo accounts seeded by supabase/migrations/20260813101702_seed_marketplace_demo_data.sql.
# These are throwaway credentials for a throwaway dataset, published in that
# migration rather than kept here — they are not secrets and there is nothing to
# fill in below. Never reuse the password for anything real.
#
#   Sellers: acoustic@demo.market, displayworks@demo.market, keyforge@demo.market,
#            homesafe@demo.market, northpage@demo.market
#   Buyer:   jane@demo.market
#
# homesafe@demo.market is the seller CURRENT_SELLER_ID in lib/data/products.ts
# stands in for, so it is the account to sign in as when /seller starts reading
# from Supabase in step 04.
