# Names only. Real values live in .env / .env.local, which are gitignored.
# Copy this file, fill it in locally, and never commit the filled-in copy.

# Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase *anon* key. The only key the browser may ever see — it is the
# public, RLS-constrained key, and every policy written in step 03 assumes it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Deliberately not listed: SUPABASE_SERVICE_ROLE_KEY. It bypasses RLS, must
# never take a NEXT_PUBLIC_ prefix, and no application code reads it. If a
# query only works with the service role, the policy is wrong — fix the policy.
