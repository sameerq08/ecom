# Copy to .env.local (gitignored) and fill in from the Supabase dashboard:
# Project Settings -> API. Never commit real values.

# Project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Safe to expose to the browser — RLS is what protects
# the data behind it, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS entirely. Server-only: must never take a
# NEXT_PUBLIC_ prefix, never be imported into a client component, and never be
# reachable from the browser bundle. Unused as of step 03.
SUPABASE_SERVICE_ROLE_KEY=
